# Application
APP_ENV=development

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Reranker Model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM / SLM
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Directories
DATA_DIR=./data
MODEL_DIR=./models
CACHE_DIR=./cache

# Retrieval
TOP_K_VECTOR=20
TOP_K_GRAPH=20
TOP_K_LEXICAL=20
TOP_K_FINAL=8

# Generation
TEMPERATURE=0.1
MAX_TOKENS=2048

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
